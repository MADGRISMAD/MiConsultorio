# Copy to .env and fill in. Used by docker-compose.yml and as a reference for local runs.

# PostgreSQL (docker-compose creates the database with these values)
POSTGRES_USER=caresia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caresia

# Signing key for session tokens: at least 32 random characters.
#   openssl rand -hex 32
JWT_SECRET=

# Public URL(s) allowed to make state-changing requests, comma-separated.
# Leave empty when the app is served from the same origin as the API (the default).
ALLOWED_ORIGINS=

# Set to false only for plain-http local development (the session cookie is Secure otherwise).
COOKIE_SECURE=true
