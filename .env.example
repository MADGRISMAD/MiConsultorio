# CAMBIA: tu contraseña de PostgreSQL (la base "caresia" se crea sola)
DATABASE_URL=postgres://postgres:tu-contraseña@localhost:5432/caresia?sslmode=disable

# CAMBIA: cualquier cadena larga y aleatoria (32+ caracteres)
JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria-de-mas-de-32-caracteres
COOKIE_SECURE=false

# Tu clínica y administrador (se crean solos en el primer arranque)
CLINIC_NAME=Mi Clínica
ADMIN_EMAIL=clinica@ejemplo.com
ADMIN_USERNAME=admin
# CAMBIA: mínimo 8 caracteres
ADMIN_PASSWORD=pon-aqui-tu-clave