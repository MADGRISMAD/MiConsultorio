# Copia este archivo a ".env" (en la raíz del proyecto) y ajusta los valores marcados.
# El backend lo lee solo al arrancar; no hay que exportar nada. El archivo ".env" no se sube a git.

# --- Base de datos (PostgreSQL) ---
# AJUSTA usuario y contraseña a los de tu PostgreSQL. La base "caresia" se crea sola si no existe.
DATABASE_URL=postgres://postgres:TU_CONTRASENA@localhost:5432/caresia?sslmode=disable

# --- Seguridad ---
# Cadena aleatoria de 32+ caracteres. Genera una con:  openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_ALEATORIA_DE_32_O_MAS_CARACTERES
# false = funciona en http://localhost. Pon true cuando uses HTTPS.
COOKIE_SECURE=false

# --- Administrador de la plataforma (quien administra Caresia: negocios, suscripciones y equipo) ---
# Se crea solo en el primer arranque si todavía no existe uno. Entra a /login con el correo o el usuario.
PLATFORM_ADMIN_NAME=Administrador de Caresia
PLATFORM_ADMIN_EMAIL=admin@tu-dominio.com
PLATFORM_ADMIN_USERNAME=plataforma
# Mínimo 8 caracteres. Si lleva # o espacios, enciérrala entre comillas.
PLATFORM_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE

# --- Consultorio de ejemplo (opcional, útil en desarrollo) ---
# Si la base no tiene ningún consultorio, se crea este con su administrador. Déjalo vacío para omitirlo.
CLINIC_NAME=Mi Clínica
# GENERAL_MEDICAL, DENTAL, PEDIATRICS, INTERNAL_MEDICINE, PHYSIOTHERAPY, NUTRITION, PSYCHOLOGY,
# DERMATOLOGY, GYNECOLOGY, ORTHOPEDICS, VETERINARY o CHIROPRACTIC
CLINIC_KIND=GENERAL_MEDICAL
CLINIC_ADMIN_NAME=Dra. Ejemplo
CLINIC_ADMIN_EMAIL=clinica@ejemplo.com
CLINIC_ADMIN_USERNAME=admin
# Mínimo 8 caracteres.
CLINIC_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE

# --- Direcciones públicas ---
# APP_URL: dónde abren la app tus usuarios (a ahí regresa Mercado Pago tras un pago).
# API_PUBLIC_URL: dirección pública de ESTE servidor SIN "/api" al final (webhooks y OAuth de Mercado Pago).
# En local los dos sirven con http://localhost:5173 y http://localhost:8080, pero Mercado Pago no puede
# avisar a localhost: para probar webhooks usa un túnel HTTPS (ngrok/cloudflared) en API_PUBLIC_URL.
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080

# --- Correo saliente (opcional): recuperar contraseña, bienvenida, tickets y avisos de pago ---
# Sin SMTP la app funciona igual; "¿La olvidaste?" explica entonces cómo pedirle el cambio a un administrador.
# Con Gmail: activa la verificación en dos pasos y crea una "contraseña de aplicación" (no uses tu clave normal).
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Caresia <tu-correo@gmail.com>

# --- Cobro de suscripciones con Mercado Pago (opcional) ---
# Credenciales de la cuenta de Mercado Pago de Caresia (la que recibe el pago de los planes).
# Sin MP_ACCESS_TOKEN el botón "Pagar" avisa que el pago en línea no está configurado.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_CURRENCY=MXN
MP_SANDBOX=false
# Secreto de firma de webhooks (Mercado Pago > Tus integraciones > Webhooks). Si lo pones, se exige la firma.
MP_WEBHOOK_SECRET=
# Precios en pesos que sustituyen a los del catálogo (opcional). Anual por defecto = 10 meses.
# MP_PLAN_BASICO_PRICE=499
# MP_PLAN_CRECIMIENTO_PRICE=1199
# MP_PLAN_PRO_PRICE=
# MP_PLAN_CRECIMIENTO_YEAR_PRICE=11990

# --- Cobros de cada consultorio con su propia cuenta de Mercado Pago (Point y ligas de pago) ---
# Aplicación OAuth de Mercado Pago (Tus integraciones). Cada consultorio la autoriza desde "Ajustes de cobros".
# En Mercado Pago > Tu aplicación debes registrar:
#   - Redirect URL:  <API_PUBLIC_URL>/api/point/oauth/callback   (igual a MP_OAUTH_REDIRECT)
#   - Webhooks, evento "Order (Mercado Pago)" y "Pagos":  <API_PUBLIC_URL>/api/webhooks/mercadopago
#     (también responde en <API_PUBLIC_URL>/api/point/webhook; usa la misma MP_WEBHOOK_SECRET)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Es la que se envía a Mercado Pago como redirect_uri; debe coincidir letra por letra con la registrada.
# Si la omites se usa  <API_PUBLIC_URL>/api/point/oauth/callback
MP_OAUTH_REDIRECT=http://localhost:8080/api/point/oauth/callback
# Cifrado de los tokens guardados y firma del estado OAuth. Si los omites se derivan de JWT_SECRET.
# Genera cada uno con:  openssl rand -hex 32
# TOKEN_ENC_KEY=
# OAUTH_STATE_SECRET=

# --- Inventario Mágico y Precio Mágico (Gemini, opcional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Solo si usas Docker (docker compose) ---
# POSTGRES_PASSWORD=
