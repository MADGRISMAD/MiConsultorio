{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://miconsultorio.15-235-62-27.sslip.io/api/public/sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://miconsultorio.15-235-62-27.sslip.io/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
